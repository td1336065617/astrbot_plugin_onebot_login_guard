{
  "guard_enabled": {"description": "启用登录守护", "type": "bool", "default": true},
  "poll_interval": {"description": "轮询间隔（秒）", "type": "int", "default": 30, "hint": "10~600。太短会频繁读日志，太长会延迟发现掉线。"},
  "notify_cooldown": {"description": "同类通知冷却（秒）", "type": "int", "default": 600},
  "offline_confirm_rounds": {"description": "判定掉线的连续失败次数", "type": "int", "default": 2, "hint": "用于吸收协议端重启抖动，避免误报。"},
  "notify_on_recover": {"description": "恢复登录时通知", "type": "bool", "default": true},
  "qr_refresh_notify": {"description": "二维码刷新时重发", "type": "bool", "default": true},
  "send_qr_image": {"description": "发送二维码图片", "type": "bool", "default": true},
  "send_qr_url": {"description": "附带二维码解码链接", "type": "bool", "default": true},
  "max_events": {"description": "保留事件条数", "type": "int", "default": 200},
  "log_tail_bytes": {"description": "每次读取日志的尾部字节数", "type": "int", "default": 65536},
  "instances": {
    "description": "被守护的 OneBot 实例（可多个）",
    "type": "list",
    "default": [],
    "items": {
      "description": "实例",
      "type": "object",
      "items": {
        "instance_id": {"description": "实例标识（自定义，唯一）", "type": "string", "default": "default"},
        "platform_id": {"description": "AstrBot 平台实例 ID", "type": "string", "default": "default"},
        "log_path": {"description": "协议端日志路径（同主机时填）", "type": "string", "default": ""},
        "qr_path": {"description": "协议端二维码图片路径（同主机时填）", "type": "string", "default": ""},
        "http_url": {"description": "协议端 WebUI 地址（可选，跨主机时用）", "type": "string", "default": ""},
        "http_token": {"description": "WebUI token（可选）", "type": "string", "default": ""},
        "regex_need_login": {"description": "自定义『需要登录』正则（留空用内置）", "type": "string", "default": ""},
        "regex_online": {"description": "自定义『登录成功』正则（留空用内置）", "type": "string", "default": ""}
      }
    }
  },
  "notify_sessions": {"description": "AstrBot 会话（unified_msg_origin）列表", "type": "list", "default": [], "hint": "建议填另一个还活着的平台会话，例如 Telegram 私聊或 QQ 官方号群。"},
  "webhooks": {
    "description": "外部 Webhook 渠道",
    "type": "list",
    "default": [],
    "items": {
      "description": "渠道",
      "type": "object",
      "items": {
        "type": {"description": "类型", "type": "string", "options": ["wecom", "dingtalk", "feishu", "telegram", "generic"], "default": "generic"},
        "url": {"description": "Webhook 地址", "type": "string", "default": ""},
        "token": {"description": "密钥 / token（telegram 的 bot token）", "type": "string", "default": ""},
        "at_mobiles": {"description": "钉钉 @手机号（可选）", "type": "list", "default": []}
      }
    }
  },
  "email": {
    "description": "邮件通知",
    "type": "object",
    "items": {
      "enable": {"description": "启用邮件通知", "type": "bool", "default": false},
      "smtp_host": {"description": "SMTP 服务器", "type": "string", "default": ""},
      "smtp_port": {"description": "SMTP 端口", "type": "int", "default": 465},
      "security": {"description": "加密方式", "type": "string", "options": ["ssl", "starttls", "none"], "default": "ssl"},
      "username": {"description": "登录用户名", "type": "string", "default": ""},
      "password": {"description": "登录密码 / 授权码", "type": "string", "default": ""},
      "from_addr": {"description": "发件人（留空则用用户名）", "type": "string", "default": ""},
      "to_addrs": {"description": "收件人列表", "type": "list", "default": []}
    }
  }
}
